!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------- Next.js / build ----------
.next
out
dist
.output
build/Release
*.tsbuildinfo
next-env.d.ts

# ---------- Logs y reportes ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------- Runtime / cobertura / caches ----------
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage
*.lcov
.nyc_output
.grunt
.lock-wscript
.cache
.parcel-cache
.nuxt
.temp
.svelte-kit/
