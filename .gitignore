**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.vercel

# ---------- Caché de fuentes abiertas ----------
/src/data/cache/

