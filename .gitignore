# ============================================================
# .gitignore · ielts-arion — versión endurecida (auditoría)
# Base: plantilla Node de GitHub + refuerzos ARION.
# Privacidad: Ley 1581 de 2012 (principio de minimización).
# ============================================================

# ---------- Secrets y variables de entorno (YA cubierto, se mantiene) ----------
.env
.env.*
!.env.example          # solo la plantilla pública se versiona

# ---------- Dependencias (rendimiento: clon y CI ligeros) ----------
node_modules/
jspm_packages/
web_modules/
bower_components/
.pnp.*
.pnpm-store
.npm
.yarn-integrity
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------- Next.js / build ----------
.next                  # artefacto de build: nunca al repo
out
dist
.output
build/Release
*.tsbuildinfo
next-env.d.ts          # AÑADIDO ARION: Next lo regenera en cada dev/build

# ---------- Logs y reportes (pueden volcar tokens en texto claro) ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pnpm-debug.log*        # AÑADIDO ARION: usamos pnpm como gestor

# ---------- Runtime / cobertura / caches ----------
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage
*.lcov
.nyc_output
.grunt
.lock-wscript
.cache
.parcel-cache
.nuxt
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.vercel                # AÑADIDO ARION: metadatos locales de despliegue

# ---------- AÑADIDO ARION: caché de fuentes abiertas ----------
# El adaptador de datos regenera esta carpeta; no debe versionarse.
/src/data/cache/

# ---------- AÑADIDO ARION: datos personales del estudiante ----------
# Grabaciones de Speaking y progreso local = dato personal sensible.
/public/recordings/
*.webm
*.sqlite
*.db
*.export.json

# ---------- AÑADIDO ARION: material criptográfico ----------
*.pem
*.key
*.p12
*.pfx

# ---------- AÑADIDO ARION: SO y editores ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# NOTA: public/ SÍ se versiona (assets con licencia abierta);
# solo se excluye /public/recordings/ (dato personal).
