# .env.example — plantilla PÚBLICA; valores reales van al gestor de secretos.
PORT=3000            # evita conflictos de puerto en entornos compartidos
NODE_ENV=development
AI_PROVIDER=         # opcional: sin esto, degrada a motor heurístico local
AI_API_KEY=          # NUNCA commitear valores reales (Ley 1581/2012)
# Opcional · IA adaptativa (M5). Sin estas variables, la app usa el plan heurístico.
AI_PROVIDER=openai
OPENAI_API_KEY=